<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="dz.energy.energy_backend.model">


    <class name="ProductItem" table="product_item">

        <id name="id" type="integer" column="id">
            <generator class="native"/>
        </id>

        <property name="price" type="double" column="price"/>

        <many-to-one name="seller" class="Seller" column="seller_id" not-null="true"/>
        <many-to-one name="product" class="Product" column="product_id" not-null="true"/>
    </class>

</hibernate-mapping>